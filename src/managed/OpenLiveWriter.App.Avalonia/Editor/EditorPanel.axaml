<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="OpenLiveWriter.App.Avalonia.Editor.EditorPanel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <DockPanel LastChildFill="True">
        <!-- In-editor find bar (Cmd/Ctrl+F). Hidden until opened; Replace All stays
             on the Find & Replace dialog as a fallback. -->
        <Border x:Name="FindBar"
                DockPanel.Dock="Top"
                Background="#FFF8E7"
                BorderBrush="#E8D9A8"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                IsVisible="False"
                MinHeight="36"
                ClipToBounds="True">
            <!-- Horizontal scroll so Match case / Next / Replace stay reachable at 800px -->
            <ScrollViewer x:Name="FindBarScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <DockPanel LastChildFill="True" MinWidth="560">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <TextBlock x:Name="FindMatchCountText" Text=""
                                   FontSize="11" Foreground="#777777"
                                   VerticalAlignment="Center" MinWidth="64"
                                   TextAlignment="Right" Margin="0,0,4,0" />
                        <CheckBox x:Name="FindMatchCaseCheck" Content="Match case"
                                  FontSize="11" VerticalAlignment="Center"
                                  MinHeight="24" />
                        <Button x:Name="FindPreviousButton" Content="Previous"
                                Height="26" MinHeight="24" Padding="8,2" FontSize="12" MinWidth="70" />
                        <Button x:Name="FindNextButton" Content="Next"
                                Height="26" MinHeight="24" Padding="8,2" FontSize="12" MinWidth="56"
                                IsDefault="True" />
                        <Button x:Name="FindReplaceDialogButton" Content="Replace…"
                                Height="26" MinHeight="24" Padding="8,2" FontSize="12" MinWidth="72"
                                ToolTip.Tip="Open Find &amp; Replace dialog" />
                        <Button x:Name="FindCloseButton" Content="✕"
                                Height="26" MinHeight="24" Width="28" Padding="0"
                                FontSize="12" ToolTip.Tip="Close (Esc)" />
                    </StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Find"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#555555" />
                        <TextBox x:Name="FindQueryBox"
                                 PlaceholderText="Find in post…"
                                 Height="26"
                                 MinHeight="24"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 MinWidth="120" />
                    </DockPanel>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <!-- Editor content area (switches between Edit, Source, Preview).
             ContentControls default to Left/Top content alignment in Avalonia —
             Stretch is required so the WebView fills the remaining client area on resize. -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- WYSIWYG Editor (WebView or fallback) -->
            <ContentControl x:Name="EditorHost"
                            IsVisible="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <!-- Source HTML view: developer font, line numbers, syntax highlighting -->
            <avaloniaEdit:TextEditor x:Name="SourceEditor"
                     IsVisible="False"
                     ShowLineNumbers="True"
                     WordWrap="False"
                     FontSize="13"
                     FontFamily="Menlo, Monaco, 'Courier New', monospace"
                     Padding="8"
                     BorderThickness="0"
                     Background="#1E1E1E"
                     Foreground="#D4D4D4"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" />

            <!-- Preview (read-only WebView) -->
            <ContentControl x:Name="PreviewHost"
                            IsVisible="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </DockPanel>
</UserControl>
