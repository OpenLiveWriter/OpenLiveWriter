<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenLiveWriter.App.Avalonia.Editor.EditorPanel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <DockPanel LastChildFill="True">
        <!-- Slim chrome: view toggles only. Formatting lives on the ribbon Home tab
             so this secondary strip no longer duplicates Bold/Italic/etc. -->
        <Border DockPanel.Dock="Top"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="8,2"
                MinHeight="32"
                MaxHeight="36">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="EditViewButton" Content="Edit" IsChecked="True"
                                  Height="26" MinWidth="48" Padding="8,2" FontSize="12" />
                    <ToggleButton x:Name="SourceViewButton" Content="Source"
                                  Height="26" MinWidth="56" Padding="8,2" FontSize="12" />
                    <ToggleButton x:Name="PreviewViewButton" Content="Preview"
                                  Height="26" MinWidth="56" Padding="8,2" FontSize="12" />
                </StackPanel>
                <TextBlock Text="Editing"
                           FontSize="11"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           IsVisible="False" />
            </DockPanel>
        </Border>

        <!-- In-editor find bar (Cmd/Ctrl+F). Hidden until opened; Replace All stays
             on the Find & Replace dialog as a fallback. -->
        <Border x:Name="FindBar"
                DockPanel.Dock="Top"
                Background="#FFF8E7"
                BorderBrush="#E8D9A8"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                IsVisible="False"
                MinHeight="36">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <CheckBox x:Name="FindMatchCaseCheck" Content="Match case"
                              FontSize="11" VerticalAlignment="Center" />
                    <Button x:Name="FindPreviousButton" Content="Previous"
                            Height="26" Padding="8,2" FontSize="12" MinWidth="70" />
                    <Button x:Name="FindNextButton" Content="Next"
                            Height="26" Padding="8,2" FontSize="12" MinWidth="56"
                            IsDefault="True" />
                    <Button x:Name="FindReplaceDialogButton" Content="Replace…"
                            Height="26" Padding="8,2" FontSize="12" MinWidth="72"
                            ToolTip.Tip="Open Find &amp; Replace dialog" />
                    <Button x:Name="FindCloseButton" Content="✕"
                            Height="26" Width="28" Padding="0"
                            FontSize="12" ToolTip.Tip="Close (Esc)" />
                </StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Find"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="#555555" />
                    <TextBox x:Name="FindQueryBox"
                             PlaceholderText="Find in post…"
                             Height="26"
                             FontSize="12"
                             VerticalAlignment="Center"
                             MinWidth="120" />
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Editor content area (switches between Edit, Source, Preview).
             ContentControls default to Left/Top content alignment in Avalonia —
             Stretch is required so the WebView fills the remaining client area on resize. -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- WYSIWYG Editor (WebView or fallback) -->
            <ContentControl x:Name="EditorHost"
                            IsVisible="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <!-- Source HTML view -->
            <TextBox x:Name="SourceEditor"
                     IsVisible="False"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     FontSize="13"
                     FontFamily="Menlo, Monaco, Consolas, monospace"
                     Padding="12"
                     BorderThickness="0"
                     Background="#1E1E1E"
                     Foreground="#D4D4D4"
                     VerticalContentAlignment="Top"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" />

            <!-- Preview (read-only WebView) -->
            <ContentControl x:Name="PreviewHost"
                            IsVisible="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </DockPanel>
</UserControl>
