<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenLiveWriter.App.Avalonia.Editor.EditorPanel">

    <DockPanel>
        <!-- Editor formatting toolbar
             Focusable="False" on all buttons prevents them from stealing focus from the WebView.
             This is critical: if focus moves to the button, the WebView loses its selection
             and execCommand silently fails. -->
        <Border DockPanel.Dock="Top"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="4">
            <DockPanel>
                <!-- View toggle (right side) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                    <Border Width="1" Background="#D0D0D0" Margin="4,2" />
                    <ToggleButton x:Name="EditViewButton" Content="Edit" IsChecked="True"
                                  Height="28" Padding="8,2" FontSize="12" />
                    <ToggleButton x:Name="SourceViewButton" Content="Source"
                                  Height="28" Padding="8,2" FontSize="12" />
                    <ToggleButton x:Name="PreviewViewButton" Content="Preview"
                                  Height="28" Padding="8,2" FontSize="12" />
                </StackPanel>

                <!-- Formatting buttons (left side) — all Focusable="False" -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BoldButton" Content="B" FontWeight="Bold"
                            Focusable="False"
                            Width="28" Height="28" FontSize="13"
                            ToolTip.Tip="Bold (Ctrl+B)" />
                    <Button x:Name="ItalicButton" Content="I" FontStyle="Italic"
                            Focusable="False"
                            Width="28" Height="28" FontSize="13"
                            ToolTip.Tip="Italic (Ctrl+I)" />
                    <Button x:Name="UnderlineButton" Focusable="False"
                            Width="28" Height="28" FontSize="13"
                            ToolTip.Tip="Underline (Ctrl+U)">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </Button>
                    <Button x:Name="StrikethroughButton" Focusable="False"
                            Width="28" Height="28" FontSize="13"
                            ToolTip.Tip="Strikethrough">
                        <TextBlock Text="S" TextDecorations="Strikethrough" />
                    </Button>

                    <Border Width="1" Background="#D0D0D0" Margin="4,2" />

                    <ComboBox x:Name="HeadingCombo" Width="120" Height="28" SelectedIndex="0"
                              Focusable="False">
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Heading 1" />
                        <ComboBoxItem Content="Heading 2" />
                        <ComboBoxItem Content="Heading 3" />
                    </ComboBox>

                    <Border Width="1" Background="#D0D0D0" Margin="4,2" />

                    <Button x:Name="BulletListButton" Content="* List" Height="28" Padding="8,2"
                            Focusable="False"
                            ToolTip.Tip="Bullet List" />
                    <Button x:Name="NumberListButton" Content="1. List" Height="28" Padding="8,2"
                            Focusable="False"
                            ToolTip.Tip="Numbered List" />

                    <Border Width="1" Background="#D0D0D0" Margin="4,2" />

                    <Button x:Name="LinkButton" Content="Link" Height="28" Padding="8,2"
                            Focusable="False"
                            ToolTip.Tip="Insert Hyperlink (Ctrl+K)" />
                    <Button x:Name="ImageButton" Content="Image" Height="28" Padding="8,2"
                            Focusable="False"
                            ToolTip.Tip="Insert Image" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Editor content area (switches between Edit, Source, Preview) -->
        <Grid>
            <!-- WYSIWYG Editor (WebView or fallback) -->
            <ContentControl x:Name="EditorHost" IsVisible="True" />

            <!-- Source HTML view -->
            <TextBox x:Name="SourceEditor"
                     IsVisible="False"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     FontSize="13"
                     FontFamily="Menlo, Monaco, Consolas, monospace"
                     Padding="12"
                     BorderThickness="0"
                     Background="#1E1E1E"
                     Foreground="#D4D4D4"
                     VerticalContentAlignment="Top" />

            <!-- Preview (read-only WebView) -->
            <ContentControl x:Name="PreviewHost" IsVisible="False" />
        </Grid>
    </DockPanel>
</UserControl>
