<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenLiveWriter.App.Avalonia.App"
             Name="Open Live Writer"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <!-- AvaloniaEdit (Source view code editor) theme -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- Shared macOS-style control styling (see AppStyles.axaml; also loaded
             by the headless test app so UiReview captures match production). -->
        <StyleInclude Source="avares://OpenLiveWriter.App.Avalonia/AppStyles.axaml" />
    </Application.Styles>
</Application>
