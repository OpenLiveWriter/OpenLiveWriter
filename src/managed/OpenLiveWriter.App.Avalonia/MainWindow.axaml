<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenLiveWriter.App.Avalonia.MainWindow"
        Title="Open Live Writer"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Ribbon area (placeholder - will be replaced by Avalonia ribbon in M3-2) -->
        <Border DockPanel.Dock="Top"
                Background="#F0F0F0"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- Tab strip -->
                <ToggleButton Content="Home" IsChecked="True" Classes="RibbonTab" />
                <ToggleButton Content="Insert" Classes="RibbonTab" />
                <ToggleButton Content="Blog Account" Classes="RibbonTab" />
                <ToggleButton Content="Preview" Classes="RibbonTab" />
                <!-- Spacer pushes About to the right -->
                <Border Width="1" />
                <Button x:Name="AboutButton" Content="About" Classes="RibbonTab"
                        VerticalAlignment="Center" Padding="8,4" />
            </StackPanel>
        </Border>

        <!-- Ribbon content area (placeholder) -->
        <Border DockPanel.Dock="Top"
                Background="#FAFAFA"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Height="95"
                Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Clipboard group -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Paste" Height="60" Padding="12,4" />
                        <StackPanel Spacing="2">
                            <Button Content="Cut" Height="28" Padding="8,2" />
                            <Button Content="Copy" Height="28" Padding="8,2" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Clipboard" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" />
                </StackPanel>

                <!-- Separator -->
                <Border Width="1" Background="#D0D0D0" Margin="4,0" />

                <!-- Publishing group -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Publish" Height="60" Padding="12,4" FontWeight="Bold" />
                        <Button Content="Save Draft" Height="60" Padding="12,4" />
                    </StackPanel>
                    <TextBlock Text="Publishing" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" />
                </StackPanel>

                <!-- Separator -->
                <Border Width="1" Background="#D0D0D0" Margin="4,0" />

                <!-- Formatting group -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="B" FontWeight="Bold" Width="28" Height="28" />
                        <Button Content="I" FontStyle="Italic" Width="28" Height="28" />
                        <Button Content="U" Width="28" Height="28" />
                        <Button Content="S" Width="28" Height="28" />
                    </StackPanel>
                    <TextBlock Text="Formatting" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#F0F0F0"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock Text="Ready" FontSize="12" Foreground="#666666" />
        </Border>

        <!-- Main content area - editor placeholder -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Editor area -->
            <DockPanel>
                <!-- Title bar -->
                <Border DockPanel.Dock="Top" Padding="12,8" Background="White">
                    <TextBox PlaceholderText="Post Title"
                             FontSize="24"
                             FontWeight="Light"
                             BorderThickness="0"
                             Background="Transparent" />
                </Border>

                <!-- Editor content (placeholder for WebView) -->
                <Border Background="White" Padding="12">
                    <TextBox AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             PlaceholderText="Start writing your blog post..."
                             FontSize="16"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Top" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
