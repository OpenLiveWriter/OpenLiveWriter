<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:OpenLiveWriter.App.Avalonia.Editor"
        x:Class="OpenLiveWriter.App.Avalonia.MainWindow"
        Title="Open Live Writer"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Ribbon control (dynamically populated from RibbonConfiguration) -->
        <Border DockPanel.Dock="Top" x:Name="RibbonHost" />

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#F0F0F0"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="BlogStatusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="#444444"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Text="No blog selected" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Ready"
                           FontSize="12"
                           Foreground="#666666"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WordCountStatusText"
                           Grid.Column="2"
                           FontSize="12"
                           Foreground="#444444"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           IsVisible="False" />
            </Grid>
        </Border>

        <!-- Main content area -->
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Padding="12,8" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <TextBox x:Name="TitleEditor"
                         PlaceholderText="Post Title"
                         FontSize="24"
                         FontWeight="Light"
                         BorderThickness="0"
                         Background="Transparent" />
            </Border>

            <!-- Editor panel with formatting toolbar and content area -->
            <editor:EditorPanel x:Name="EditorPanel" />
        </DockPanel>
    </DockPanel>
</Window>
