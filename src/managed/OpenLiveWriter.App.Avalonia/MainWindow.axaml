<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:OpenLiveWriter.App.Avalonia.Editor"
        x:Class="OpenLiveWriter.App.Avalonia.MainWindow"
        Title="Open Live Writer"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        CanResize="True"
        WindowDecorations="Full"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">
        <!-- Ribbon control (dynamically populated from RibbonConfiguration) -->
        <Border DockPanel.Dock="Top"
                x:Name="RibbonHost"
                HorizontalAlignment="Stretch"
                ClipToBounds="False" />

        <!-- Status bar — pinned; does not consume editor space -->
        <Border x:Name="StatusBar"
                DockPanel.Dock="Bottom"
                Background="#F3F3F3"
                BorderBrush="#C8C8C8"
                BorderThickness="0,1,0,0"
                Padding="12,5"
                MinHeight="30"
                MaxHeight="36">
            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="20">
                <TextBlock x:Name="BlogStatusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="#3A3A3A"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220"
                           Text="No blog selected" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Ready"
                           FontSize="12"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WordCountStatusText"
                           Grid.Column="2"
                           FontSize="12"
                           Foreground="#3A3A3A"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="False" />
            </Grid>
        </Border>

        <!-- Main content area: title + editor fill remaining height -->
        <DockPanel LastChildFill="True">
            <!-- Title bar -->
            <Border DockPanel.Dock="Top"
                    Padding="14,8"
                    Background="White"
                    BorderBrush="#E2E2E2"
                    BorderThickness="0,0,0,1"
                    MinHeight="48">
                <TextBox x:Name="TitleEditor"
                         PlaceholderText="Post Title"
                         FontSize="24"
                         FontWeight="Normal"
                         BorderThickness="0"
                         Background="Transparent"
                         MinHeight="34"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap" />
            </Border>

            <!-- Editor panel with formatting toolbar and content area -->
            <editor:EditorPanel x:Name="EditorPanel"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
        </DockPanel>
    </DockPanel>
</Window>
