<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenLiveWriter.App.Avalonia.Dialogs.MessageDialog"
        Title="Open Live Writer"
        Width="450"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <DockPanel Margin="24">
        <!-- Buttons at bottom -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,20,0,0">
            <Button x:Name="PrimaryButton" Content="OK" IsDefault="True"
                    Width="88" Height="32" HorizontalContentAlignment="Center" />
            <Button x:Name="SecondaryButton" Content="Cancel" IsCancel="True"
                    Width="88" Height="32" HorizontalContentAlignment="Center"
                    IsVisible="False" />
        </StackPanel>

        <!-- Message content -->
        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" FontSize="14" TextWrapping="Wrap" Foreground="#444444" LineHeight="20" />
        </StackPanel>
    </DockPanel>
</Window>
