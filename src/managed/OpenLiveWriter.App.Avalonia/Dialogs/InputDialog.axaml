<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenLiveWriter.App.Avalonia.Dialogs.InputDialog"
        Title="Open Live Writer"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="PromptText" FontSize="14" TextWrapping="Wrap" />
        <TextBox x:Name="InputTextBox" Height="32" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="OKButton" Content="OK" IsDefault="True"
                    Width="88" Height="32" HorizontalContentAlignment="Center" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                    Width="88" Height="32" HorizontalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</Window>
