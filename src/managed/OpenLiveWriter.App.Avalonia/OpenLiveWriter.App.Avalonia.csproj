<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OpenLiveWriter.App.Avalonia</AssemblyName>
    <RootNamespace>OpenLiveWriter.App.Avalonia</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputType>Exe</OutputType>
    <!-- App display name for macOS menu bar and dock -->
    <Product>Open Live Writer</Product>
    <AssemblyTitle>Open Live Writer</AssemblyTitle>
    <CFBundleName>Open Live Writer</CFBundleName>
    <CFBundleDisplayName>Open Live Writer</CFBundleDisplayName>
    <CFBundleIdentifier>org.openlivewriter.app</CFBundleIdentifier>
    <!-- Avalonia needs this for XAML compilation -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="WeCantSpell.Hunspell" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editor\Resources\editor.html" />
    <EmbeddedResource Include="Spelling\Dictionaries\en_US.dic" />
    <EmbeddedResource Include="Spelling\Dictionaries\en_US.aff" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLiveWriter.Platform\OpenLiveWriter.Platform.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Platform.Mac\OpenLiveWriter.Platform.Mac.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Ribbon.Avalonia\OpenLiveWriter.Ribbon.Avalonia.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Publishing\OpenLiveWriter.Publishing.csproj" />
  </ItemGroup>
</Project>
