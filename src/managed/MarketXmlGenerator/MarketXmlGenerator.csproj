<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MarketXmlGenerator</AssemblyName>
    <RootNamespace>MarketXmlGenerator</RootNamespace>
    <ProjectGuid>{D286C651-2AE7-447E-BBD8-B82F1C542667}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <!-- Override Directory.Build.props: this is a cross-platform build tool,
         not a Windows Forms app. It only uses System.Xml and System.IO. -->
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="GlobalAssemblyInfo.cs" />
    <!-- No GlobalAssemblyVersionInfo.cs include: only the native C++ ribbon
         project imports writer.build.targets, so the dotnet CLI never generates
         that file. The version comes from Directory.Build.props. -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="App.ico" />
    <None Include="app.config" />
  </ItemGroup>

</Project>
