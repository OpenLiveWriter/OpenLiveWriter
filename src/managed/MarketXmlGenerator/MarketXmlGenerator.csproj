<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MarketXmlGenerator</AssemblyName>
    <RootNamespace>MarketXmlGenerator</RootNamespace>
    <ProjectGuid>{D286C651-2AE7-447E-BBD8-B82F1C542667}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <!-- Override Directory.Build.props: this is a cross-platform build tool,
         not a Windows Forms app. It only uses System.Xml and System.IO. -->
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="GlobalAssemblyInfo.cs" />
    <!-- GlobalAssemblyVersionInfo.cs is generated by writer.build.targets at build time.
         This build tool does not need it; removing to avoid CI failures when building
         with dotnet CLI (which does not invoke the legacy MSBuild targets). -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="App.ico" />
    <None Include="app.config" />
  </ItemGroup>

</Project>
