    <RootNamespace>OpenLiveWriter.Platform</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Cross-platform project: override x64 from Directory.Build.props -->
