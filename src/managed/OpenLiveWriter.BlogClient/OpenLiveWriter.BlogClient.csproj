<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OpenLiveWriter.BlogClient</AssemblyName>
    <RootNamespace>OpenLiveWriter.BlogClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="GlobalAssemblyInfo.cs" />
    <Compile Include="**\*.cs" Exclude="obj\**;Clients\SixApartAtomClient.cs" />
    <!-- SixApartAtomClient.cs is excluded - incomplete/deprecated implementation -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.resx" />
    <EmbeddedResource Include="**\*.xml" Exclude="obj\**" />
    <EmbeddedResource Include="**\*.json" Exclude="obj\**" />
    <EmbeddedResource Include="**\*.ico" Exclude="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Detection\default.htm" CopyToOutputDirectory="PreserveNewest" Link="template\default.htm" />
    <Content Include="Detection\defaultstyle.css" CopyToOutputDirectory="PreserveNewest" Link="template\defaultstyle.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.Blogger.v3" />
    <PackageReference Include="Google.Apis.Core" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLiveWriter.Api\OpenLiveWriter.Api.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.BrowserControl\OpenLiveWriter.BrowserControl.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Controls\OpenLiveWriter.Controls.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.CoreServices\OpenLiveWriter.CoreServices.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Extensibility\OpenLiveWriter.Extensibility.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.FileDestinations\OpenLiveWriter.FileDestinations.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.HtmlParser\OpenLiveWriter.HtmlParser.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Interop.Mshtml\OpenLiveWriter.Interop.Mshtml.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Interop\OpenLiveWriter.Interop.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Localization\OpenLiveWriter.Localization.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Mshtml\OpenLiveWriter.Mshtml.csproj" />
  </ItemGroup>
</Project>